            <button class="glider-next text-white hover:text-gray-400">»</button>
            <div class="dots"></div>

            <button class="closeModal absolute top-4 right-4 text-gray-500 hover:text-gray-900">
                <i class="fas fa-x"></i>
            </button>
        </div>
    </div>
