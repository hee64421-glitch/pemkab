<!-- PROFIL MPP KBB -->
<section id="profile-mpp" class="py-16 lg:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-6">
            <div class="relative">
                <div class="absolute -bottom-4 -right-4 w-full h-full bg-mpp-teal/20 rounded-2xl"></div>
                <div class="relative aspect-[4/3] rounded-2xl overflow-hidden shadow-xl bg-gradient-to-br from-mpp-dark to-mpp-teal-dark">
                    <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?w=800&q=80" alt="Gedung MPP KBB" class="w-full h-full object-cover opacity-70">
                </div>
            </div>
        </div>
        <div class="lg:col-span-6">
            <span class="text-mpp-teal-dark font-semibold text-sm uppercase tracking-wide">Tentang MPP KBB</span>
            <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mt-2 mb-4">Pusat Layanan Publik Satu Atap</h2>
            <p class="text-gray-700 text-justify leading-relaxed mb-4">
                Mal Pelayanan Publik (MPP) Kabupaten Bandung Barat merupakan inisiatif Pemerintah Kabupaten Bandung Barat untuk mengintegrasikan berbagai layanan publik dari berbagai instansi di satu lokasi fisik maupun digital.
            </p>
            <p class="text-gray-700 text-justify leading-relaxed mb-6">
                Dengan konsep "satu atap", masyarakat dapat mengurus berbagai keperluan administratif tanpa harus berpindah-pindah lokasi. Didukung dengan sistem antrian online dan integrasi digital, MPP KBB siap memberikan pengalaman pelayanan yang modern dan efisien.
            </p>
            <div class="grid grid-cols-2 gap-4">
                <div class="bg-white rounded-xl p-4 border border-gray-100">
                    <i class="fas fa-map-marker-alt text-mpp-teal-dark text-xl mb-2"></i>
                    <div class="text-xs text-gray-500">Lokasi</div>
                    <div class="text-sm font-semibold text-gray-900">Ngamprah, Padalarang</div>
                </div>
                <div class="bg-white rounded-xl p-4 border border-gray-100">
                    <i class="fas fa-calendar text-mpp-teal-dark text-xl mb-2"></i>
                    <div class="text-xs text-gray-500">Berdiri Sejak</div>
                    <div class="text-sm font-semibold text-gray-900">5 Maret 2023</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- KEUNGGULAN MPP -->
<section class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
            <span class="text-mpp-teal-dark font-semibold text-sm uppercase tracking-wide">Keunggulan</span>
            <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mt-2">Mengapa Memilih MPP KBB?</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <div class="text-center p-6 rounded-2xl border border-gray-100 hover:border-mpp-teal hover:shadow-lg transition">
                <div class="w-16 h-16 rounded-2xl bg-mpp-dark/10 text-mpp-dark flex items-center justify-center mx-auto mb-4"><i class="fas fa-bolt text-2xl"></i></div>
                <h3 class="font-bold text-gray-900 mb-2">Cepat</h3>
                <p class="text-sm text-gray-500">Layanan dengan estimasi waktu jelas dan sistem antrian online.</p>
            </div>
            <div class="text-center p-6 rounded-2xl border border-gray-100 hover:border-mpp-teal hover:shadow-lg transition">
                <div class="w-16 h-16 rounded-2xl bg-mpp-teal-dark/10 text-mpp-teal-dark flex items-center justify-center mx-auto mb-4"><i class="fas fa-handshake text-2xl"></i></div>
                <h3 class="font-bold text-gray-900 mb-2">Mudah</h3>
                <p class="text-sm text-gray-500">Proses booking dan persyaratan jelas, semua di satu tempat.</p>
            </div>
            <div class="text-center p-6 rounded-2xl border border-gray-100 hover:border-mpp-teal hover:shadow-lg transition">
                <div class="w-16 h-16 rounded-2xl bg-mpp-accent/15 text-mpp-accent flex items-center justify-center mx-auto mb-4"><i class="fas fa-tags text-2xl"></i></div>
                <h3 class="font-bold text-gray-900 mb-2">Terjangkau</h3>
                <p class="text-sm text-gray-500">Biaya transparan, banyak layanan gratis tanpa biaya tambahan.</p>
            </div>
            <div class="text-center p-6 rounded-2xl border border-gray-100 hover:border-mpp-teal hover:shadow-lg transition">
                <div class="w-16 h-16 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto mb-4"><i class="fas fa-couch text-2xl"></i></div>
                <h3 class="font-bold text-gray-900 mb-2">Nyaman</h3>
                <p class="text-sm text-gray-500">Fasilitas modern, ruang tunggu nyaman, petugas ramah.</p>
            </div>
        </div>
    </div>
</section>

<!-- ALUR PELAYANAN -->
<section class="py-16 lg:py-24 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
            <span class="text-mpp-teal-dark font-semibold text-sm uppercase tracking-wide">Proses Mudah</span>
            <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mt-2">Bagaimana Alur Pelayanannya?</h2>
